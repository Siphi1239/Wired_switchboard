/*
 * nRF52840-DK + Microchip LAN8651 10BASE-T1S MAC-PHY on the Arduino header
 * (e.g. MIKROE "Two-Wire ETH Click" on an Arduino-UNO click shield, or a
 * hand-wired LAN8651 breakout).
 *
 *   LAN8651     DK (Arduino)    nRF52840
 *   SCK         D13             P1.15
 *   SDO (MISO)  D12             P1.14
 *   SDI (MOSI)  D11             P1.13
 *   CS_N        D10             P1.12
 *   IRQ_N       D7              P1.08   (adapt to your shield)
 *   RESET_N     D8              P1.10   (adapt to your shield)
 *
 * SPIM3 is the only nRF52840 SPI master above 8 MHz. It supports 16/32 MHz;
 * the LAN865x allows max 25 MHz, so the driver ends up at 16 MHz. That is
 * plenty for a 10 Mbit/s shared bus with OA-TC6 framing overhead.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>

&arduino_spi {
	status = "okay";

	t1s0: lan865x@0 {
		compatible = "microchip,lan865x";
		reg = <0>;
		spi-max-frequency = <16000000>;
		int-gpios = <&arduino_header ARDUINO_HEADER_R3_D7 GPIO_ACTIVE_LOW>;
		rst-gpios = <&arduino_header ARDUINO_HEADER_R3_D8 GPIO_ACTIVE_LOW>;
		/* Placeholder - overwritten at runtime from FICR (locally administered). */
		local-mac-address = [02 00 00 00 00 01];
		status = "okay";

		t1s0_mdio: lan865x_mdio {
			compatible = "microchip,lan865x-mdio";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			t1s0_phy: ethernet-phy@0 {
				compatible = "microchip,t1s-phy";
				reg = <0x0>;
				/* Boot defaults only; the app re-applies the provisioned
				 * PLCA config from NVS (see `sb plca` shell command). */
				plca-enable;
				plca-node-id = <1>;
				plca-node-count = <8>;
				plca-burst-count = <0>;
				plca-burst-timer = <0x80>;
				plca-to-timer = <0x20>;
				status = "okay";
			};
		};
	};
};

/ {
	/*
	 * Switchboard I/O. On the DK: LED1..LED3 stand in for relays,
	 * Button1..Button3 are the local wall-switch inputs.
	 * LED0 = status LED, Button4 long press = factory reset.
	 * On the real board, map relay drivers / opto inputs here.
	 */
	zephyr,user {
		relay-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>,
			      <&gpio0 15 GPIO_ACTIVE_LOW>,
			      <&gpio0 16 GPIO_ACTIVE_LOW>;
		button-gpios = <&gpio0 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			       <&gpio0 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			       <&gpio0 24 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		status-led-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
		reset-button-gpios = <&gpio0 25 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};
};

/* The DK's I2C0/SPI0/SPI1 are not needed; free the pins and power. */
&spi1 {
	status = "disabled";
};
